# Mesmo projeto Supabase do App-Compras (nfijlzndlioefayctbsh) — este app
# usa o schema `requerimentos`, não `public`. Painel do projeto > Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://nfijlzndlioefayctbsh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Exclusiva do servidor. Nunca expor no cliente nem commitar. Mesma chave
